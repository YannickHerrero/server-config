#!/usr/bin/env python3
"""Read and update the ignored Multica policy for the original repository."""

from __future__ import annotations

import argparse
import copy
import json
import os
from pathlib import Path
import sys
from typing import Any

import yaml

sys.path.insert(0, "/usr/local/lib/server-config")

from multica_project import (
    POLICY_FILE,
    ProjectError,
    atomic_yaml,
    load_policy,
    load_state,
    locked,
    project_map_entry,
    run,
    validate_policy,
)


def repository_root(path: Path) -> Path:
    result = run(
        ["git", "-C", str(path.expanduser()), "rev-parse", "--show-toplevel"],
        check=False,
    )
    if result.returncode != 0:
        raise ProjectError(f"not inside a Git repository: {path}")
    return Path(result.stdout.strip()).resolve()


def resolve_policy(repository: Path, state_path: Path) -> Path:
    direct = repository / POLICY_FILE
    if direct.exists():
        return direct
    state = load_state(state_path)
    _identity, entry = project_map_entry(state, repository)
    return Path(str(entry["path"])).resolve() / POLICY_FILE


def dotted_get(value: Any, dotted: str) -> Any:
    current = value
    if not dotted:
        return current
    for component in dotted.split("."):
        if not isinstance(current, dict) or component not in current:
            raise ProjectError(f"project policy has no key: {dotted}")
        current = current[component]
    return current


def dotted_set(policy: dict[str, Any], dotted: str, value: Any) -> dict[str, Any]:
    components = [component for component in dotted.split(".") if component]
    if not components:
        raise ProjectError("policy key is empty")
    updated = copy.deepcopy(policy)
    current: dict[str, Any] = updated
    for component in components[:-1]:
        child = current.get(component)
        if child is None:
            child = {}
            current[component] = child
        if not isinstance(child, dict):
            raise ProjectError(f"policy key is not an object: {component}")
        current = child
    current[components[-1]] = value
    return validate_policy(updated)


def print_value(value: Any) -> None:
    if isinstance(value, (dict, list)):
        yaml.safe_dump(value, sys.stdout, sort_keys=False, allow_unicode=True)
    elif value is None:
        print("null")
    elif isinstance(value, bool):
        print("true" if value else "false")
    else:
        print(value)


def parser() -> argparse.ArgumentParser:
    arguments = argparse.ArgumentParser(description=__doc__)
    arguments.add_argument("--repo", type=Path, default=Path.cwd())
    arguments.add_argument(
        "--state",
        type=Path,
        default=Path(
            os.environ.get(
                "MULTICA_PROJECT_MAP",
                str(Path.home() / ".local/state/multica/project-map.json"),
            )
        ),
    )
    subcommands = arguments.add_subparsers(dest="command", required=True)
    subcommands.add_parser("path")
    get_parser = subcommands.add_parser("get")
    get_parser.add_argument("key", nargs="?", default="")
    set_parser = subcommands.add_parser("set")
    set_parser.add_argument("key")
    set_parser.add_argument("value", help="YAML scalar, object, or list")
    subcommands.add_parser("validate")
    return arguments


def main() -> int:
    arguments = parser().parse_args()
    try:
        repository = repository_root(arguments.repo)
        policy_path = resolve_policy(repository, arguments.state)
        if arguments.command == "path":
            print(policy_path)
            return 0
        policy = load_policy(policy_path)
        if arguments.command == "validate":
            print(f"valid: {policy_path}")
            return 0
        if arguments.command == "get":
            print_value(dotted_get(policy, arguments.key))
            return 0

        try:
            value = yaml.safe_load(arguments.value)
        except yaml.YAMLError as error:
            raise ProjectError(f"invalid YAML value: {error}") from error
        lock_path = policy_path.with_suffix(policy_path.suffix + ".lock")
        with locked(lock_path):
            current = load_policy(policy_path)
            atomic_yaml(policy_path, dotted_set(current, arguments.key, value))
        print(f"updated {arguments.key} in {policy_path}")
        return 0
    except ProjectError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
