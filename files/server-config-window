#!/usr/bin/env python3
"""Time-bounded broker for applying server-config without a persistent sudo grant."""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import selectors
import signal
import socket
import struct
import subprocess
import sys
import time
from dataclasses import dataclass
from typing import Callable, Sequence

MAX_MINUTES = 8 * 60
MIN_MINUTES = 1
DEFAULT_MINUTES = 30
MAX_SECONDS = MAX_MINUTES * 60
SOCKET_PATH = Path("/run/server-config-maintenance-window/window.sock")
ACTIVE_PATH = Path("/run/server-config-maintenance-window/active.json")
SUSPENDED_STATE_PATH = Path("/run/server-config-maintenance-window/suspended-services.json")
LOCK_PATH = Path("/run/server-config-maintenance-window.lock")
LOG_DIR = Path("/var/log/server-config")
SYSTEMCTL = "/usr/bin/systemctl"
RUNUSER = "/usr/sbin/runuser"
ENV = "/usr/bin/env"
GIT = "/usr/bin/git"
ANSIBLE_PLAYBOOK = "/usr/bin/ansible-playbook"
SUPERVISORCTL = "/usr/bin/supervisorctl"
CITADEL_PROGRAM = "citadel-dashboard"
WINDOW_UNIT_PREFIX = "server-config-maintenance-window"
ALWAYS_SKIPPED_TAGS = ("citadel", "maintenance-window")
SENSITIVE_TAGS = ("access", "firewall", "ssh", "sudo", "tailscale", "users")
CONVERGENCE_SCOPES = {
    "android": ("android",),
    "docker": ("docker",),
    "herdr": ("herdr",),
    "mise": ("mise",),
    "neovim": ("neovim",),
    "onboarding": ("onboarding",),
    "pi": ("pi",),
    "shell": ("shell",),
    "transmission": ("transmission",),
    "user-config": ("user-config",),
}
RECAP_RE = re.compile(
    r"^[A-Za-z0-9_.-]+\s+:\s+ok=\d+\s+changed=0\s+unreachable=0\s+failed=0",
    re.MULTILINE,
)
SUPERVISOR_STATUS_RE = re.compile(r"^([A-Za-z0-9:_-]+)\s+([A-Z]+)(?:\s|$)")
SUPERVISOR_STABLE_STATES = {"EXITED", "FATAL", "RUNNING", "STOPPED", "UNKNOWN"}
SUPERVISOR_STATUS_RETURN_CODES = {0, 3}


class WindowError(RuntimeError):
    """A maintenance-window operation failed safely."""


@dataclass(frozen=True)
class Authorization:
    seconds: int
    allow_sensitive: bool

    @property
    def instance(self) -> str:
        scope = "sensitive" if self.allow_sensitive else "safe"
        return f"{self.seconds}-{scope}"


@dataclass(frozen=True)
class BrokerConfig:
    authorization: Authorization
    user: str
    uid: int
    gid: int
    home: Path
    repo: Path
    supervisor_config: Path
    socket_path: Path = SOCKET_PATH
    lock_path: Path = LOCK_PATH
    log_dir: Path = LOG_DIR
    active_path: Path = ACTIVE_PATH
    suspended_state_path: Path = SUSPENDED_STATE_PATH


@dataclass(frozen=True)
class CommandResult:
    returncode: int
    output: str
    timed_out: bool = False
    duration_seconds: float = 0


@dataclass(frozen=True)
class BrokerRequest:
    command: str
    scope: str | None = None


def parse_authorization(value: str) -> Authorization:
    match = re.fullmatch(r"([0-9]+)-(safe|sensitive)", value)
    if match is None:
        raise WindowError("invalid maintenance-window authorization")
    seconds = int(match.group(1))
    if seconds < MIN_MINUTES * 60 or seconds > MAX_SECONDS:
        raise WindowError(f"window duration must be between 1 and {MAX_MINUTES} minutes")
    return Authorization(seconds=seconds, allow_sensitive=match.group(2) == "sensitive")


def authorization_for(minutes: int, allow_sensitive: bool) -> Authorization:
    if minutes < MIN_MINUTES or minutes > MAX_MINUTES:
        raise WindowError(f"window duration must be between 1 and {MAX_MINUTES} minutes")
    return Authorization(seconds=minutes * 60, allow_sensitive=allow_sensitive)


def format_duration(seconds: int) -> str:
    seconds = max(0, seconds)
    hours, remainder = divmod(seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    parts = []
    if hours:
        parts.append(f"{hours}h")
    if minutes or hours:
        parts.append(f"{minutes}m")
    parts.append(f"{seconds}s")
    return " ".join(parts)


def format_elapsed(seconds: float) -> str:
    if seconds < 60:
        return f"{seconds:.1f}s"
    minutes, seconds = divmod(seconds, 60)
    return f"{int(minutes)}m {seconds:.1f}s"


def send_message(connection: socket.socket | None, payload: dict[str, object]) -> None:
    if connection is None:
        return
    try:
        connection.sendall((json.dumps(payload, separators=(",", ":")) + "\n").encode())
    except (BrokenPipeError, ConnectionResetError, OSError):
        pass


def user_environment(config: BrokerConfig) -> list[str]:
    path = (
        f"{config.home}/.local/share/mise/shims:{config.home}/.local/bin:"
        "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    )
    return [f"HOME={config.home}", f"USER={config.user}", f"LOGNAME={config.user}", f"PATH={path}"]


def as_user(config: BrokerConfig, command: Sequence[str]) -> list[str]:
    return [RUNUSER, "-u", config.user, "--", ENV, "--", *user_environment(config), *command]


def skipped_tags(allow_sensitive: bool) -> tuple[str, ...]:
    if allow_sensitive:
        return ALWAYS_SKIPPED_TAGS
    return (*ALWAYS_SKIPPED_TAGS, *SENSITIVE_TAGS)


def convergence_tags(scope: str | None) -> tuple[str, ...]:
    if scope is None:
        return ()
    try:
        return CONVERGENCE_SCOPES[scope]
    except KeyError as error:
        raise WindowError(f"unsupported convergence scope: {scope}") from error


def ansible_command(config: BrokerConfig, *, check: bool, scope: str | None = None) -> list[str]:
    command = [
        ANSIBLE_PLAYBOOK,
        "--inventory",
        str(config.repo / "inventory/localhost.yml"),
    ]
    if check:
        command.extend(("--check", "--diff"))
    tags = convergence_tags(scope)
    if tags:
        command.extend(("--tags", ",".join(tags)))
    allow_sensitive = config.authorization.allow_sensitive and scope is None
    command.extend(
        (
            "--skip-tags",
            ",".join(skipped_tags(allow_sensitive)),
            "--extra-vars",
            "server_config_maintenance_broker=true",
            "--extra-vars",
            f"server_config_managed_user={config.user}",
            str(config.repo / "playbook.yml"),
        )
    )
    return command


def terminate_process(process: subprocess.Popen[bytes]) -> None:
    with contextlib.suppress(ProcessLookupError):
        os.killpg(process.pid, signal.SIGTERM)
    try:
        process.wait(timeout=5)
    except subprocess.TimeoutExpired:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(process.pid, signal.SIGKILL)
        process.wait()


def run_command(
    command: Sequence[str],
    *,
    cwd: Path,
    environment: dict[str, str],
    deadline: float,
    connection: socket.socket | None,
    log_file,
    label: str,
) -> CommandResult:
    started_at = time.monotonic()
    header = f"\n== {label} ==\n$ {' '.join(command)}\n"
    log_file.write(header.encode())
    log_file.flush()
    send_message(connection, {"type": "output", "data": header})

    process = subprocess.Popen(
        list(command),
        cwd=cwd,
        env=environment,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    assert process.stdout is not None
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    output_tail = b""
    timed_out = False

    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                terminate_process(process)
                break
            events = selector.select(timeout=min(0.5, remaining))
            for key, _ in events:
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                log_file.write(chunk)
                log_file.flush()
                output_tail = (output_tail + chunk)[-2_000_000:]
                send_message(connection, {"type": "output", "data": chunk.decode(errors="replace")})
            if process.poll() is not None and not events:
                with contextlib.suppress(KeyError):
                    selector.unregister(process.stdout)
    finally:
        selector.close()
        if process.poll() is None:
            terminate_process(process)
        process.stdout.close()

    returncode = process.wait()
    if timed_out:
        timeout_message = "\nMaintenance window expired; terminated the running command.\n"
        log_file.write(timeout_message.encode())
        send_message(connection, {"type": "output", "data": timeout_message})
    duration_seconds = time.monotonic() - started_at
    timing_message = f"\n[{label} finished in {format_elapsed(duration_seconds)}]\n"
    log_file.write(timing_message.encode())
    log_file.flush()
    send_message(connection, {"type": "output", "data": timing_message})
    return CommandResult(
        returncode=returncode,
        output=output_tail.decode(errors="replace"),
        timed_out=timed_out,
        duration_seconds=duration_seconds,
    )


def capture_as_user(config: BrokerConfig, command: Sequence[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        as_user(config, command),
        cwd=config.repo,
        check=False,
        capture_output=True,
        text=True,
        timeout=30,
    )


def supervisor_as_user(
    config: BrokerConfig,
    arguments: Sequence[str],
    *,
    timeout: int = 330,
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            as_user(config, [SUPERVISORCTL, "-c", str(config.supervisor_config), *arguments]),
            cwd=config.home,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as error:
        raise WindowError("Citadel Supervisor operation timed out") from error


def supervisor_status(config: BrokerConfig) -> dict[str, str]:
    result = supervisor_as_user(config, ["status"], timeout=30)
    if result.returncode not in SUPERVISOR_STATUS_RETURN_CODES:
        detail = (result.stderr or result.stdout).strip()
        raise WindowError(f"cannot inspect Citadel services: {detail}")
    statuses: dict[str, str] = {}
    for line in result.stdout.splitlines():
        match = SUPERVISOR_STATUS_RE.match(line)
        if match is None:
            raise WindowError(f"cannot parse Supervisor status: {line}")
        name, state = match.groups()
        statuses[name] = state
    if statuses.get(CITADEL_PROGRAM) != "RUNNING":
        raise WindowError("Citadel must be running before a maintenance window opens")
    return statuses


def write_private_json(path: Path, value: object, *, gid: int, mode: int = 0o600) -> None:
    path.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
    try:
        with os.fdopen(descriptor, "w") as file:
            json.dump(value, file, sort_keys=True)
            file.write("\n")
        os.chown(temporary, 0 if os.geteuid() == 0 else os.geteuid(), gid)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            temporary.unlink()


def suspended_service_names(path: Path) -> list[str]:
    if not path.is_file():
        return []
    try:
        value = json.loads(path.read_text())
    except (json.JSONDecodeError, OSError) as error:
        raise WindowError("cannot read the suspended Citadel service state") from error
    services = value.get("services") if isinstance(value, dict) else None
    if not isinstance(services, list) or any(
        not isinstance(name, str) or re.fullmatch(r"[A-Za-z0-9:_-]+", name) is None
        for name in services
    ):
        raise WindowError("invalid suspended Citadel service state")
    return services


def suspend_supervisor_services(config: BrokerConfig) -> list[str]:
    statuses = supervisor_status(config)
    transient = [
        name for name, state in statuses.items()
        if name != CITADEL_PROGRAM and state not in SUPERVISOR_STABLE_STATES
    ]
    if transient:
        raise WindowError(
            "wait for transient Citadel services before opening the window: "
            + ", ".join(sorted(transient))
        )
    active_maintenance = [
        name for name, state in statuses.items()
        if name.startswith("maintenance-") and state == "RUNNING"
    ]
    if active_maintenance:
        raise WindowError(
            "wait for Citadel maintenance actions before opening the window: "
            + ", ".join(sorted(active_maintenance))
        )
    running = sorted(
        name for name, state in statuses.items()
        if name != CITADEL_PROGRAM and not name.startswith("maintenance-") and state == "RUNNING"
    )
    write_private_json(
        config.suspended_state_path,
        {"services": running},
        gid=config.gid,
    )
    for name in running:
        result = supervisor_as_user(config, ["stop", name])
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip()
            raise WindowError(f"cannot suspend Citadel service {name}: {detail}")
    remaining = [
        name for name, state in supervisor_status(config).items()
        if name != CITADEL_PROGRAM and state == "RUNNING"
    ]
    if remaining:
        raise WindowError("Citadel services remained active: " + ", ".join(sorted(remaining)))
    return running


def restore_supervisor_services(config: BrokerConfig) -> list[str]:
    services = suspended_service_names(config.suspended_state_path)
    if not services:
        with contextlib.suppress(FileNotFoundError):
            config.suspended_state_path.unlink()
        return []
    statuses = supervisor_status(config)
    failures: list[str] = []
    pending = list(services)
    for name in services:
        state = statuses.get(name)
        if state not in {"RUNNING", "STARTING"}:
            result = supervisor_as_user(config, ["start", name])
            if result.returncode != 0:
                failures.append(name)
                continue
        pending.remove(name)
        write_private_json(
            config.suspended_state_path,
            {"services": pending},
            gid=config.gid,
        )
    if not pending:
        with contextlib.suppress(FileNotFoundError):
            config.suspended_state_path.unlink()
    return failures


def mark_window(config: BrokerConfig, state: str) -> None:
    write_private_json(
        config.active_path,
        {"state": state},
        gid=config.gid,
        mode=0o640,
    )


def require_repo_state(
    config: BrokerConfig,
    expected_commit: str | None = None,
    capture: Callable[[BrokerConfig, Sequence[str]], subprocess.CompletedProcess[str]] = capture_as_user,
) -> str:
    status = capture(config, [GIT, "status", "--porcelain=v1", "--untracked-files=all"])
    if status.returncode != 0:
        raise WindowError(f"cannot inspect repository status: {status.stderr.strip()}")
    if status.stdout:
        raise WindowError("server-config must have a clean worktree before convergence")

    branch = capture(config, [GIT, "branch", "--show-current"])
    if branch.returncode != 0 or branch.stdout.strip() != "main":
        raise WindowError("server-config must be on main before convergence")

    upstream = capture(config, [GIT, "rev-parse", "--abbrev-ref", "@{upstream}"])
    if upstream.returncode != 0 or upstream.stdout.strip() != "origin/main":
        raise WindowError("server-config main must track origin/main")

    counts = capture(config, [GIT, "rev-list", "--left-right", "--count", "origin/main...HEAD"])
    if counts.returncode != 0:
        raise WindowError(f"cannot compare server-config with origin/main: {counts.stderr.strip()}")
    try:
        behind, _ahead = (int(value) for value in counts.stdout.split())
    except (ValueError, TypeError) as error:
        raise WindowError("cannot parse server-config divergence") from error
    if behind:
        raise WindowError("server-config is behind or diverged from origin/main")

    head = capture(config, [GIT, "rev-parse", "HEAD"])
    if head.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}\n?", head.stdout):
        raise WindowError("cannot read the server-config commit")
    commit = head.stdout.strip()
    if expected_commit is not None and commit != expected_commit:
        raise WindowError("server-config changed after the dry run; run convergence again")
    return commit


def audit(log_dir: Path, event: str, **details: object) -> None:
    log_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(log_dir, 0o700)
    record = {
        "time": dt.datetime.now(dt.UTC).isoformat(),
        "event": event,
        **details,
    }
    descriptor = os.open(log_dir / "maintenance-window.jsonl", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(descriptor, "a") as file:
        file.write(json.dumps(record, sort_keys=True) + "\n")


def run_convergence(
    config: BrokerConfig,
    *,
    deadline: float,
    connection: socket.socket | None,
    scope: str | None = None,
) -> tuple[bool, str]:
    started_at = time.monotonic()
    try:
        convergence_tags(scope)
        commit = require_repo_state(config)
    except WindowError as error:
        return False, str(error)

    timestamp = dt.datetime.now(dt.UTC).strftime("%Y%m%dT%H%M%SZ")
    log_path = config.log_dir / f"maintenance-window-{timestamp}-{os.getpid()}.log"
    config.log_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(config.log_dir, 0o700)
    descriptor = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    environment = os.environ.copy()
    environment.update(
        {
            "ANSIBLE_CONFIG": str(config.repo / "ansible.cfg"),
            "SERVER_CONFIG_MAINTENANCE_WINDOW": "1",
        }
    )

    steps: list[tuple[str, list[str]]] = [
        ("Validate", as_user(config, [str(config.repo / "bin/validate")])),
        ("Dry run", ansible_command(config, check=True, scope=scope)),
    ]

    audit(
        config.log_dir,
        "converge-start",
        commit=commit,
        scope=scope or "full",
        sensitive=config.authorization.allow_sensitive,
    )
    success = False
    message = "convergence failed"
    with os.fdopen(descriptor, "wb") as log_file:
        for label, command in steps:
            result = run_command(
                command,
                cwd=config.repo,
                environment=environment,
                deadline=deadline,
                connection=connection,
                log_file=log_file,
                label=label,
            )
            if result.returncode != 0:
                message = f"{label.lower()} failed"
                if result.timed_out:
                    message = "maintenance window expired"
                break
        else:
            try:
                require_repo_state(config, expected_commit=commit)
            except WindowError as error:
                message = str(error)
            else:
                apply_result = run_command(
                    ansible_command(config, check=False, scope=scope),
                    cwd=config.repo,
                    environment=environment,
                    deadline=deadline,
                    connection=connection,
                    log_file=log_file,
                    label="Apply",
                )
                if apply_result.returncode != 0:
                    message = "apply failed"
                    if apply_result.timed_out:
                        message = "maintenance window expired"
                else:
                    verify_result = run_command(
                        ansible_command(config, check=True, scope=scope),
                        cwd=config.repo,
                        environment=environment,
                        deadline=deadline,
                        connection=connection,
                        log_file=log_file,
                        label="Verify convergence",
                    )
                    if verify_result.returncode != 0 or RECAP_RE.search(verify_result.output) is None:
                        message = "post-apply check did not report changed=0"
                    else:
                        doctor_result = run_command(
                            as_user(config, [str(config.repo / "bin/doctor")]),
                            cwd=config.repo,
                            environment=environment,
                            deadline=deadline,
                            connection=connection,
                            log_file=log_file,
                            label="Doctor",
                        )
                        if doctor_result.returncode != 0:
                            message = "doctor failed"
                        else:
                            try:
                                require_repo_state(config, expected_commit=commit)
                            except WindowError as error:
                                message = str(error)
                            else:
                                success = True
                                target = f"scope {scope} at " if scope else ""
                                message = f"converged {target}commit {commit[:12]}"

    duration_seconds = time.monotonic() - started_at
    audit(
        config.log_dir,
        "converge-finish",
        commit=commit,
        scope=scope or "full",
        success=success,
        message=message,
        durationSeconds=round(duration_seconds, 3),
        log=str(log_path),
    )
    if success:
        message = f"{message} in {format_elapsed(duration_seconds)}"
    return success, message


def peer_uid(connection: socket.socket) -> int:
    credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    _pid, uid, _gid = struct.unpack("3i", credentials)
    return uid


def peer_is_authorized(uid: int, managed_uid: int) -> bool:
    return uid in {0, managed_uid}


def receive_request(connection: socket.socket) -> BrokerRequest:
    data = b""
    while b"\n" not in data and len(data) <= 4096:
        chunk = connection.recv(4096)
        if not chunk:
            break
        data += chunk
    if len(data) > 4096:
        raise WindowError("request is too large")
    try:
        payload = json.loads(data.split(b"\n", 1)[0])
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise WindowError("invalid request") from error
    if not isinstance(payload, dict):
        raise WindowError("invalid request")
    command = payload.get("command")
    if command not in {"close", "converge", "status"}:
        raise WindowError("unsupported request")
    scope = payload.get("scope")
    if scope is not None:
        if command != "converge" or not isinstance(scope, str):
            raise WindowError("scope is only supported for convergence")
        convergence_tags(scope)
    return BrokerRequest(command=command, scope=scope)


def acquire_window_lock(path: Path) -> int:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError as error:
        os.close(descriptor)
        raise WindowError("another server-config maintenance window is active") from error
    return descriptor


def validate_broker_config(config: BrokerConfig) -> None:
    if os.geteuid() != 0:
        raise WindowError("the maintenance-window daemon must run as root")
    account = pwd.getpwnam(config.user)
    if account.pw_uid != config.uid or account.pw_gid != config.gid:
        raise WindowError("managed-user identity does not match the installed unit")
    if Path(account.pw_dir) != config.home:
        raise WindowError("managed-user home does not match the installed unit")
    if not config.repo.is_absolute() or not config.repo.is_dir():
        raise WindowError("the configured server-config repository is unavailable")
    if config.repo.stat().st_uid != config.uid:
        raise WindowError("the configured server-config repository has an unexpected owner")
    if not config.supervisor_config.is_absolute() or not config.supervisor_config.is_file():
        raise WindowError("the configured Citadel Supervisor file is unavailable")
    runtime_parent = config.socket_path.parent
    if any(path.parent != runtime_parent for path in (config.active_path, config.suspended_state_path)):
        raise WindowError("maintenance-window runtime paths must share one directory")


def run_daemon(config: BrokerConfig) -> int:
    validate_broker_config(config)
    deadline = time.monotonic() + config.authorization.seconds
    stop_requested = False
    lock_descriptor = acquire_window_lock(config.lock_path)
    listener: socket.socket | None = None
    restore_error: str | None = None
    restore_failures: list[str] = []

    config.socket_path.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    for path in (config.socket_path, config.active_path):
        if path.exists() or path.is_symlink():
            path.unlink()

    try:
        mark_window(config, "opening")
        suspended = suspend_supervisor_services(config)
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(str(config.socket_path))
        os.chown(config.socket_path, 0 if os.geteuid() == 0 else os.geteuid(), config.gid)
        os.chmod(config.socket_path, 0o660)
        listener.listen(4)
        listener.settimeout(1)
        mark_window(config, "open")
        signal.signal(signal.SIGTERM, lambda _signum, _frame: listener.close())
        signal.signal(signal.SIGINT, lambda _signum, _frame: listener.close())
        audit(
            config.log_dir,
            "window-open",
            seconds=config.authorization.seconds,
            sensitive=config.authorization.allow_sensitive,
            suspended=suspended,
            user=config.user,
        )

        while not stop_requested and time.monotonic() < deadline:
            try:
                connection, _ = listener.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            with connection:
                if not peer_is_authorized(peer_uid(connection), config.uid):
                    send_message(connection, {"type": "result", "ok": False, "message": "unauthorized user"})
                    continue
                try:
                    request_message = receive_request(connection)
                except WindowError as error:
                    send_message(connection, {"type": "result", "ok": False, "message": str(error)})
                    continue
                if request_message.command == "status":
                    remaining = max(0, int(deadline - time.monotonic()))
                    send_message(
                        connection,
                        {
                            "type": "result",
                            "ok": True,
                            "message": "open",
                            "state": "open",
                            "remainingSeconds": remaining,
                            "allowSensitive": config.authorization.allow_sensitive,
                            "maxSeconds": MAX_SECONDS,
                        },
                    )
                elif request_message.command == "close":
                    mark_window(config, "closing")
                    send_message(connection, {"type": "result", "ok": True, "message": "closing"})
                    stop_requested = True
                else:
                    success, message = run_convergence(
                        config,
                        deadline=deadline,
                        connection=connection,
                        scope=request_message.scope,
                    )
                    send_message(connection, {"type": "result", "ok": success, "message": message})
    finally:
        if listener is not None:
            with contextlib.suppress(OSError):
                listener.close()
        with contextlib.suppress(FileNotFoundError):
            config.socket_path.unlink()
        with contextlib.suppress(OSError):
            mark_window(config, "restoring")
        try:
            restore_failures = restore_supervisor_services(config)
        except WindowError as error:
            restore_error = str(error)
        with contextlib.suppress(FileNotFoundError):
            config.active_path.unlink()
        audit(
            config.log_dir,
            "window-close",
            expired=time.monotonic() >= deadline,
            restoreError=restore_error,
            restoreFailures=restore_failures,
        )
        os.close(lock_descriptor)
    if restore_error:
        raise WindowError(restore_error)
    if restore_failures:
        raise WindowError("cannot restore Citadel services: " + ", ".join(restore_failures))
    return 0


def restore_services_after_stop(
    *,
    user: str,
    home: Path,
    supervisor_config: Path,
    state_path: Path,
) -> int:
    if os.geteuid() != 0:
        raise WindowError("service restoration must run as root")
    account = pwd.getpwnam(user)
    if Path(account.pw_dir) != home:
        raise WindowError("managed-user home does not match during service restoration")
    config = BrokerConfig(
        authorization=Authorization(seconds=MIN_MINUTES * 60, allow_sensitive=False),
        user=user,
        uid=account.pw_uid,
        gid=account.pw_gid,
        home=home,
        repo=home,
        supervisor_config=supervisor_config,
        suspended_state_path=state_path,
    )
    failures = restore_supervisor_services(config)
    if failures:
        raise WindowError("cannot restore Citadel services: " + ", ".join(failures))
    return 0


def request(
    command: str,
    socket_path: Path = SOCKET_PATH,
    *,
    scope: str | None = None,
) -> dict[str, object]:
    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        connection.connect(str(socket_path))
    except (FileNotFoundError, ConnectionRefusedError, PermissionError) as error:
        raise WindowError("no server-config maintenance window is open") from error
    with connection:
        payload = {"command": command}
        if scope is not None:
            payload["scope"] = scope
        connection.sendall((json.dumps(payload) + "\n").encode())
        buffer = b""
        result: dict[str, object] | None = None
        while True:
            try:
                chunk = connection.recv(65536)
            except ConnectionResetError:
                break
            if not chunk:
                break
            buffer += chunk
            while b"\n" in buffer:
                line, buffer = buffer.split(b"\n", 1)
                if not line:
                    continue
                payload = json.loads(line)
                if payload.get("type") == "output":
                    sys.stdout.write(str(payload.get("data", "")))
                    sys.stdout.flush()
                elif payload.get("type") == "result":
                    result = payload
        if result is None:
            raise WindowError("maintenance-window broker disconnected without a result")
        return result


def open_window(minutes: int, allow_sensitive: bool) -> int:
    authorization = authorization_for(minutes, allow_sensitive)
    if os.geteuid() != 0:
        raise WindowError("open the window with sudo")
    if SOCKET_PATH.exists() or ACTIVE_PATH.exists():
        raise WindowError("a server-config maintenance window is already open")
    unit = f"{WINDOW_UNIT_PREFIX}@{authorization.instance}.service"
    subprocess.run([SYSTEMCTL, "start", unit], check=True)
    deadline = time.monotonic() + min(authorization.seconds, 5 * 60)
    while time.monotonic() < deadline:
        if SOCKET_PATH.is_socket():
            status = request("status")
            if status.get("ok") is True:
                print(f"Opened a {format_duration(authorization.seconds)} server-config maintenance window.")
                scope_message = (
                    "Sensitive host-access changes are allowed."
                    if allow_sensitive
                    else "Sensitive host-access changes are blocked."
                )
                print(scope_message)
                print("Citadel remains available while managed services are suspended.")
                return 0
        if subprocess.run([SYSTEMCTL, "is-active", "--quiet", unit], check=False).returncode != 0:
            raise WindowError("maintenance-window service stopped before it became ready")
        time.sleep(0.1)
    subprocess.run([SYSTEMCTL, "stop", unit], check=False)
    raise WindowError("maintenance-window service did not become ready")


def print_status() -> int:
    status = request("status")
    if status.get("ok") is not True:
        raise WindowError(str(status.get("message", "status request failed")))
    remaining = int(status.get("remainingSeconds", 0))
    print("Maintenance window: open")
    print(f"Remaining: {format_duration(remaining)}")
    scope_message = (
        "Sensitive host-access changes: allowed"
        if status.get("allowSensitive")
        else "Sensitive host-access changes: blocked"
    )
    print(scope_message)
    print(f"Maximum duration: {MAX_MINUTES // 60}h")
    return 0


def client_command(command: str, *, scope: str | None = None) -> int:
    result = request(command, scope=scope)
    print(str(result.get("message", "")))
    return 0 if result.get("ok") is True else 1


def parser() -> argparse.ArgumentParser:
    argument_parser = argparse.ArgumentParser(description=__doc__)
    subparsers = argument_parser.add_subparsers(dest="command", required=True)

    open_parser = subparsers.add_parser("open", help="open a bounded maintenance window")
    open_parser.add_argument("--minutes", type=int, default=DEFAULT_MINUTES)
    open_parser.add_argument(
        "--allow-sensitive",
        action="store_true",
        help="allow access, firewall, SSH, Tailscale, sudo, and user tasks",
    )

    subparsers.add_parser("status", help="show the active window")
    converge_parser = subparsers.add_parser("converge", help="validate, check, apply, verify, and diagnose")
    converge_parser.add_argument(
        "--scope",
        choices=sorted(CONVERGENCE_SCOPES),
        help="limit Ansible to an allowlisted non-sensitive scope",
    )
    subparsers.add_parser("close", help="close the active window early")

    restore_parser = subparsers.add_parser("restore-services", help=argparse.SUPPRESS)
    restore_parser.add_argument("--user", required=True)
    restore_parser.add_argument("--home", required=True, type=Path)
    restore_parser.add_argument("--supervisor-config", required=True, type=Path)
    restore_parser.add_argument("--state", required=True, type=Path)

    daemon_parser = subparsers.add_parser("daemon", help=argparse.SUPPRESS)
    daemon_parser.add_argument("--authorization", required=True)
    daemon_parser.add_argument("--user", required=True)
    daemon_parser.add_argument("--uid", required=True, type=int)
    daemon_parser.add_argument("--gid", required=True, type=int)
    daemon_parser.add_argument("--home", required=True, type=Path)
    daemon_parser.add_argument("--repo", required=True, type=Path)
    daemon_parser.add_argument("--supervisor-config", required=True, type=Path)
    daemon_parser.add_argument("--socket", type=Path, default=SOCKET_PATH)
    daemon_parser.add_argument("--lock", type=Path, default=LOCK_PATH)
    daemon_parser.add_argument("--log-dir", type=Path, default=LOG_DIR)
    daemon_parser.add_argument(
        "--active-state",
        type=Path,
        default=ACTIVE_PATH,
    )
    daemon_parser.add_argument(
        "--suspended-state",
        type=Path,
        default=SUSPENDED_STATE_PATH,
    )
    return argument_parser


def main(argv: Sequence[str] | None = None) -> int:
    arguments = parser().parse_args(argv)
    try:
        if arguments.command == "open":
            return open_window(arguments.minutes, arguments.allow_sensitive)
        if arguments.command == "status":
            return print_status()
        if arguments.command == "close":
            return client_command(arguments.command)
        if arguments.command == "converge":
            return client_command(arguments.command, scope=arguments.scope)
        if arguments.command == "restore-services":
            return restore_services_after_stop(
                user=arguments.user,
                home=arguments.home,
                supervisor_config=arguments.supervisor_config,
                state_path=arguments.state,
            )
        authorization = parse_authorization(arguments.authorization)
        config = BrokerConfig(
            authorization=authorization,
            user=arguments.user,
            uid=arguments.uid,
            gid=arguments.gid,
            home=arguments.home,
            repo=arguments.repo.resolve(),
            supervisor_config=arguments.supervisor_config,
            socket_path=arguments.socket,
            lock_path=arguments.lock,
            log_dir=arguments.log_dir,
            active_path=arguments.active_state,
            suspended_state_path=arguments.suspended_state,
        )
        return run_daemon(config)
    except (WindowError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
