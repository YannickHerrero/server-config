#!/usr/bin/env python3
"""Run and stop task-owned processes with locked loopback port blocks."""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import re
import secrets
import signal
import socket
import subprocess
import sys
import tempfile
import time
from typing import Any, Sequence

PORT_MIN = int(os.environ.get("MULTICA_PORT_MIN", "41000"))
PORT_MAX = int(os.environ.get("MULTICA_PORT_MAX", "41999"))
PORT_BLOCK_SIZE = int(os.environ.get("MULTICA_PORT_BLOCK_SIZE", "10"))
STATE_DIR = Path(
    os.environ.get("MULTICA_PROCESS_STATE", str(Path.home() / ".local/state/multica/processes"))
)
SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")


class RunError(RuntimeError):
    """The requested process operation is unsafe or unavailable."""


def prepare_state() -> None:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)
    (STATE_DIR / "ports").mkdir(mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR / "ports", 0o700)


def atomic_state(path: Path, value: dict[str, Any]) -> None:
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def process_start_time(pid: int) -> str:
    try:
        line = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
    except OSError as error:
        raise RunError(f"process {pid} is not running") from error
    closing = line.rfind(")")
    fields = line[closing + 2 :].split()
    if closing < 0 or len(fields) < 20:
        raise RunError(f"cannot validate process {pid}")
    return fields[19]


def process_uid(pid: int) -> int:
    try:
        for line in Path(f"/proc/{pid}/status").read_text(encoding="utf-8").splitlines():
            if line.startswith("Uid:"):
                return int(line.split()[1])
    except (OSError, ValueError) as error:
        raise RunError(f"cannot validate process {pid}") from error
    raise RunError(f"cannot read the owner of process {pid}")


def state_is_live(state: dict[str, Any]) -> bool:
    try:
        pid = int(state["pid"])
        return (
            process_uid(pid) == os.getuid()
            and process_start_time(pid) == str(state["start_time"])
            and os.getpgid(pid) == int(state["pgid"])
        )
    except (KeyError, OSError, RunError, TypeError, ValueError):
        return False


def load_state(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RunError(f"cannot read process state {path.name}: {error}") from error
    if not isinstance(value, dict):
        raise RunError(f"invalid process state {path.name}")
    return value


def block_is_available(start: int) -> bool:
    sockets: list[socket.socket] = []
    try:
        for port in range(start, start + PORT_BLOCK_SIZE):
            candidate = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            candidate.bind(("127.0.0.1", port))
            sockets.append(candidate)
        return True
    except OSError:
        return False
    finally:
        for candidate in sockets:
            candidate.close()


def allocate_port_block() -> tuple[int, int]:
    if PORT_BLOCK_SIZE < 1 or PORT_MIN < 1024 or PORT_MAX > 65535:
        raise RunError("invalid managed port range")
    allocation_path = STATE_DIR / "allocation.lock"
    allocation = os.open(allocation_path, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        fcntl.flock(allocation, fcntl.LOCK_EX)
        last_start = PORT_MAX - PORT_BLOCK_SIZE + 1
        for start in range(PORT_MIN, last_start + 1, PORT_BLOCK_SIZE):
            path = STATE_DIR / "ports" / f"{start}.lock"
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
            try:
                fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                os.close(descriptor)
                continue
            if block_is_available(start):
                return start, descriptor
            os.close(descriptor)
    finally:
        os.close(allocation)
    raise RunError(f"no free {PORT_BLOCK_SIZE}-port block in {PORT_MIN}-{PORT_MAX}")


def normalize_command(command: Sequence[str]) -> list[str]:
    values = list(command)
    if values and values[0] == "--":
        values = values[1:]
    if not values:
        raise RunError("a foreground command is required after --")
    return values


def run_owned(command: Sequence[str]) -> int:
    prepare_state()
    argv = normalize_command(command)
    start, port_lock = allocate_port_block()
    run_id = f"{int(time.time())}-{secrets.token_hex(4)}"
    state_path = STATE_DIR / f"{run_id}.json"
    environment = os.environ.copy()
    environment.update(
        {
            "MULTICA_PORT": str(start),
            "MULTICA_PORT_BASE": str(start),
            "MULTICA_PORT_END": str(start + PORT_BLOCK_SIZE - 1),
            "PORT": str(start),
        }
    )
    child: subprocess.Popen[bytes] | None = None

    def terminate(_signum: int, _frame: Any) -> None:
        if child is not None and child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass

    previous_term = signal.signal(signal.SIGTERM, terminate)
    previous_int = signal.signal(signal.SIGINT, terminate)
    try:
        child = subprocess.Popen(argv, env=environment, start_new_session=True)
        state = {
            "command": Path(argv[0]).name,
            "pgid": child.pid,
            "pid": child.pid,
            "ports": [start, start + PORT_BLOCK_SIZE - 1],
            "run_id": run_id,
            "start_time": process_start_time(child.pid),
            "started_at": dt.datetime.now(dt.UTC).isoformat(),
            "task_id": os.environ.get("MULTICA_TASK_ID", "manual"),
        }
        atomic_state(state_path, state)
        print(
            f"multica-run {run_id}: pid {child.pid}, ports {state['ports'][0]}-{state['ports'][1]}",
            file=sys.stderr,
        )
        returncode = child.wait()
        return returncode if returncode >= 0 else 128 - returncode
    finally:
        signal.signal(signal.SIGTERM, previous_term)
        signal.signal(signal.SIGINT, previous_int)
        state_path.unlink(missing_ok=True)
        os.close(port_lock)


def state_path(run_id: str) -> Path:
    if not SAFE_ID.fullmatch(run_id):
        raise RunError("invalid run id")
    return STATE_DIR / f"{run_id}.json"


def list_owned(as_json: bool) -> int:
    prepare_state()
    states: list[dict[str, Any]] = []
    for path in sorted(STATE_DIR.glob("*.json")):
        try:
            state = load_state(path)
        except RunError:
            continue
        if not state_is_live(state):
            path.unlink(missing_ok=True)
            continue
        states.append(state)
    if as_json:
        json.dump(states, sys.stdout, indent=2, sort_keys=True)
        print()
        return 0
    if not states:
        print("No managed processes.")
        return 0
    print("RUN_ID\tPID\tPORTS\tTASK\tCOMMAND")
    for state in states:
        ports = state.get("ports", ["?", "?"])
        print(
            f"{state.get('run_id')}\t{state.get('pid')}\t{ports[0]}-{ports[1]}\t"
            f"{state.get('task_id')}\t{state.get('command')}"
        )
    return 0


def stop_owned(run_id: str) -> int:
    prepare_state()
    path = state_path(run_id)
    state = load_state(path)
    if not state_is_live(state):
        path.unlink(missing_ok=True)
        raise RunError(f"managed process is no longer running: {run_id}")
    pid = int(state["pid"])
    if process_uid(pid) != os.getuid():
        raise RunError(f"refusing to stop a process owned by another user: {pid}")
    pgid = int(state["pgid"])
    os.killpg(pgid, signal.SIGTERM)
    deadline = time.monotonic() + 10
    while time.monotonic() < deadline:
        if not state_is_live(state):
            path.unlink(missing_ok=True)
            print(f"stopped {run_id}")
            return 0
        time.sleep(0.1)
    if state_is_live(state):
        os.killpg(pgid, signal.SIGKILL)
    path.unlink(missing_ok=True)
    print(f"killed {run_id} after the stop timeout")
    return 0


def parser() -> argparse.ArgumentParser:
    arguments = argparse.ArgumentParser(description=__doc__)
    subcommands = arguments.add_subparsers(dest="operation", required=True)
    run_parser = subcommands.add_parser("run")
    run_parser.add_argument("command", nargs=argparse.REMAINDER)
    list_parser = subcommands.add_parser("list")
    list_parser.add_argument("--json", action="store_true")
    stop_parser = subcommands.add_parser("stop")
    stop_parser.add_argument("run_id")
    return arguments


def main() -> int:
    arguments = parser().parse_args()
    try:
        if arguments.operation == "run":
            return run_owned(arguments.command)
        if arguments.operation == "list":
            return list_owned(arguments.json)
        return stop_owned(arguments.run_id)
    except (OSError, RunError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
