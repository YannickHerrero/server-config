#!/usr/bin/env python3
"""Synchronize Git repositories under ~/dev with Multica projects."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sys
from typing import Any, Sequence

sys.path.insert(0, "/usr/local/lib/server-config")

from multica_project import (
    ProjectError,
    atomic_json,
    canonical_remote,
    default_branch,
    discover_repositories,
    ensure_policy,
    load_state,
    locked,
    now_utc,
    parse_resource_ref,
    repository_remote,
    run,
)


def cli_json(arguments: Sequence[str]) -> Any:
    binary = os.environ.get("MULTICA_CLI", "multica")
    result = run([binary, *arguments])
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ProjectError(f"Multica returned invalid JSON for {' '.join(arguments)}") from error


def resource_index(projects: list[dict[str, Any]]) -> dict[str, tuple[dict[str, Any], dict[str, Any]]]:
    index: dict[str, tuple[dict[str, Any], dict[str, Any]]] = {}
    for project in projects:
        project_id = str(project.get("id", ""))
        if not project_id:
            continue
        resources = cli_json(["project", "resource", "list", project_id, "--output", "json"])
        if not isinstance(resources, list):
            raise ProjectError(f"project resource list returned an object for {project_id}")
        for resource in resources:
            if not isinstance(resource, dict) or resource.get("resource_type") != "github_repo":
                continue
            reference = parse_resource_ref(resource.get("resource_ref"))
            url = reference.get("url")
            if not isinstance(url, str):
                continue
            try:
                identity, _canonical = canonical_remote(url)
            except ProjectError:
                continue
            if identity in index and index[identity][0].get("id") != project_id:
                first = index[identity][0]
                raise ProjectError(
                    f"remote {identity} is attached to projects {first.get('id')} and {project_id}"
                )
            index[identity] = (project, resource)
    return index


def workspace_repository_identities() -> set[str]:
    repositories = cli_json(["repo", "list", "--output", "json"])
    if not isinstance(repositories, list):
        raise ProjectError("workspace repository list returned an object")
    identities: set[str] = set()
    for repository in repositories:
        if not isinstance(repository, dict) or not isinstance(repository.get("url"), str):
            continue
        try:
            identity, _canonical = canonical_remote(repository["url"])
        except ProjectError:
            continue
        identities.add(identity)
    return identities


def ensure_workspace_repository(identity: str, canonical_url: str, dry_run: bool) -> None:
    if identity in workspace_repository_identities():
        return
    print(f"workspace repo: add {canonical_url}")
    if not dry_run:
        cli_json(["repo", "add", "--url", canonical_url, "--output", "json"])


def create_project(repository: Path, canonical_url: str, dry_run: bool) -> dict[str, Any]:
    title = repository.name
    print(f"project: create {title} for {canonical_url}")
    if dry_run:
        return {"id": f"dry-run:{title}", "title": title, "status": "planned"}
    result = cli_json(
        [
            "project",
            "create",
            "--title",
            title,
            "--status",
            "planned",
            "--repo",
            canonical_url,
            "--output",
            "json",
        ]
    )
    if not isinstance(result, dict) or not result.get("id"):
        raise ProjectError(f"project create returned no id for {title}")
    return result


def find_github_resource(project_id: str, identity: str) -> dict[str, Any]:
    resources = cli_json(["project", "resource", "list", project_id, "--output", "json"])
    if not isinstance(resources, list):
        raise ProjectError(f"project resource list returned an object for {project_id}")
    for resource in resources:
        if not isinstance(resource, dict) or resource.get("resource_type") != "github_repo":
            continue
        reference = parse_resource_ref(resource.get("resource_ref"))
        url = reference.get("url")
        if isinstance(url, str):
            try:
                candidate, _canonical = canonical_remote(url)
            except ProjectError:
                continue
            if candidate == identity:
                return resource
    raise ProjectError(f"new project {project_id} has no resource for {identity}")


def ensure_resource(
    project: dict[str, Any],
    resource: dict[str, Any],
    canonical_url: str,
    branch: str,
    dry_run: bool,
) -> None:
    reference = parse_resource_ref(resource.get("resource_ref"))
    wanted = {
        "url": canonical_url,
        "ref": branch,
        "default_branch_hint": branch,
    }
    if all(reference.get(key) == value for key, value in wanted.items()):
        return
    project_id = str(project.get("id", ""))
    resource_id = str(resource.get("id", ""))
    if not project_id or not resource_id:
        raise ProjectError("cannot update a project resource without ids")
    print(f"resource: update {project_id} to {canonical_url}@{branch}")
    if not dry_run:
        cli_json(
            [
                "project",
                "resource",
                "update",
                project_id,
                resource_id,
                "--url",
                canonical_url,
                "--ref",
                branch,
                "--default-branch-hint",
                branch,
                "--output",
                "json",
            ]
        )


def synchronize(dev_root: Path, state_path: Path, dry_run: bool = False) -> int:
    projects = cli_json(["project", "list", "--output", "json"])
    if not isinstance(projects, list):
        raise ProjectError("project list returned an object")
    indexed = resource_index(projects)
    state = load_state(state_path)
    next_repositories: dict[str, Any] = {}
    synchronized = 0

    for repository in discover_repositories(dev_root):
        remote = repository_remote(repository)
        if remote is None:
            print(f"skip: {repository} has no origin remote", file=sys.stderr)
            continue
        identity, canonical_url = remote
        branch = default_branch(repository, canonical_url)
        ensure_workspace_repository(identity, canonical_url, dry_run)

        existing = indexed.get(identity)
        if existing is None:
            project = create_project(repository, canonical_url, dry_run)
            if dry_run:
                resource = {
                    "id": f"dry-run:{repository.name}",
                    "resource_type": "github_repo",
                    "resource_ref": {"url": canonical_url},
                }
            else:
                resource = find_github_resource(str(project["id"]), identity)
            indexed[identity] = (project, resource)
        else:
            project, resource = existing

        ensure_resource(project, resource, canonical_url, branch, dry_run)
        policy_path = repository / ".multica/project.yaml"
        if dry_run:
            if not policy_path.exists():
                print(f"policy: create {policy_path}")
        else:
            _path, created = ensure_policy(repository, canonical_url, branch)
            if created:
                print(f"policy: create {_path}")

        next_repositories[identity] = {
            "default_branch": branch,
            "path": str(repository),
            "project_id": str(project.get("id", "")),
            "project_title": str(project.get("title", repository.name)),
            "remote": canonical_url,
        }
        synchronized += 1

    if not dry_run:
        state["repositories"] = next_repositories
        state["updated_at"] = now_utc()
        atomic_json(state_path, state)
    print(f"synchronized {synchronized} repositories")
    return synchronized


def parser() -> argparse.ArgumentParser:
    arguments = argparse.ArgumentParser(description=__doc__)
    arguments.add_argument(
        "--dev-root",
        type=Path,
        default=Path(os.environ.get("MULTICA_DEV_ROOT", "/home/yannick/dev")),
    )
    arguments.add_argument(
        "--state",
        type=Path,
        default=Path(
            os.environ.get(
                "MULTICA_PROJECT_MAP",
                str(Path.home() / ".local/state/multica/project-map.json"),
            )
        ),
    )
    arguments.add_argument("--dry-run", action="store_true")
    return arguments


def main() -> int:
    arguments = parser().parse_args()
    try:
        lock_path = arguments.state.with_suffix(arguments.state.suffix + ".lock")
        with locked(lock_path):
            synchronize(arguments.dev_root, arguments.state, arguments.dry_run)
        return 0
    except ProjectError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
