# Ansible creates the real file at ~/.config/multica/server.env with mode 0600.
# Never copy credentials back into this repository.
POSTGRES_PASSWORD=generate-with-openssl
JWT_SECRET=generate-with-openssl
MULTICA_VCS_SECRET_KEY=generate-with-openssl

# Ansible derives the public origin from this host's Tailscale DNS name.
MULTICA_IMAGE_TAG=v0.4.34
PORT=4181
FRONTEND_PORT=4182
FRONTEND_ORIGIN=https://host.tailnet.ts.net:8444
MULTICA_APP_URL=https://host.tailnet.ts.net:8444
MULTICA_DAEMON_SERVER_URL=https://host.tailnet.ts.net:8444
MULTICA_PUBLIC_URL=
ALLOW_SIGNUP=true
