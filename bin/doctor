#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
EXPECTED_NODE_VERSION=$(awk -F'"' '/^server_config_node_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_PI_VERSION=$(awk -F'"' '/^server_config_pi_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_SWAP_PATH=$(awk '/^server_config_swap_path:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
failures=0

section() {
    printf '\n== %s ==\n' "$1"
}

pass() {
    printf '[ok] %s\n' "$1"
}

warn() {
    printf '[warn] %s\n' "$1"
}

fail() {
    printf '[fail] %s\n' "$1" >&2
    failures=$((failures + 1))
}

[[ $(uname -s) == Linux ]] || {
    printf 'error: doctor runs on the managed Linux host\n' >&2
    exit 1
}

section "System"
# shellcheck source=/dev/null
. /etc/os-release
printf 'OS: %s %s\n' "${NAME:-unknown}" "${VERSION_ID:-unknown}"
printf 'Kernel: %s\n' "$(uname -r)"
printf 'Architecture: %s\n' "$(uname -m)"
printf 'Hostname: %s\n' "$(hostname)"
if [[ ${ID:-} == ubuntu && ${VERSION_ID:-} == 24.04 ]]; then
    pass "supported Ubuntu release"
else
    fail "expected Ubuntu 24.04"
fi
if [[ $(uname -m) == x86_64 ]]; then
    pass "supported architecture"
else
    fail "expected x86_64"
fi

section "CPU and KVM"
awk -F: '/model name/ {sub(/^[ \t]+/, "", $2); print "CPU: " $2; exit}' /proc/cpuinfo
printf 'Logical CPUs: %s\n' "$(getconf _NPROCESSORS_ONLN)"
if grep -Eq '^flags.*\b(vmx|svm)\b' /proc/cpuinfo; then
    pass "hardware virtualization flag present"
else
    fail "hardware virtualization flag missing"
fi
if [[ -e /dev/kvm ]]; then
    if [[ -r /dev/kvm && -w /dev/kvm ]]; then
        pass "/dev/kvm is usable by this user"
    else
        warn "/dev/kvm exists but this user cannot use it yet"
    fi
else
    warn "/dev/kvm is not available yet"
fi

section "RAID and filesystems"
cat /proc/mdstat
if grep -Eq '\[[U_]*_[U_]*\]' /proc/mdstat; then
    fail "a software RAID member is missing"
else
    pass "no degraded software RAID marker found"
fi
for mount_point in /boot /; do
    findmnt -no SOURCE,FSTYPE,SIZE,USED,AVAIL,TARGET "$mount_point" 2>/dev/null || fail "$mount_point is not mounted"
done
if sudo -n true 2>/dev/null; then
    sudo -n mdadm --detail --scan || true
else
    warn "run sudo -v before doctor for mdadm and SMART details"
fi

df -h / /boot

section "Memory and swap"
free -h
if swapon --show=NAME --noheadings | grep -Fxq "$EXPECTED_SWAP_PATH"; then
    pass "$EXPECTED_SWAP_PATH is active"
else
    fail "$EXPECTED_SWAP_PATH is not active"
fi

section "Timers and updates"
for unit in fstrim.timer apt-daily.timer apt-daily-upgrade.timer; do
    if systemctl is-enabled --quiet "$unit" && systemctl is-active --quiet "$unit"; then
        pass "$unit is enabled and active"
    else
        fail "$unit is not enabled and active"
    fi
done
if [[ -e /var/run/reboot-required ]]; then
    warn "a reboot is required"
else
    pass "no reboot is currently required"
fi

section "Pi runtime"
if command -v node >/dev/null 2>&1; then
    installed_node_version=$(node --version)
    printf 'Node.js: %s\n' "$installed_node_version"
    if [[ ${installed_node_version#v} == "$EXPECTED_NODE_VERSION" ]]; then
        pass "Node.js matches the pinned version"
    else
        fail "Node.js does not match the pinned version $EXPECTED_NODE_VERSION"
    fi
else
    fail "Node.js is not available"
fi

pi_binary="$HOME/.local/bin/pi"
if [[ -x $pi_binary ]]; then
    installed_pi_version=$($pi_binary --version)
    printf 'Pi: %s\n' "$installed_pi_version"
    if [[ $installed_pi_version == "$EXPECTED_PI_VERSION" ]]; then
        pass "Pi matches the pinned version"
    else
        fail "Pi does not match the pinned version $EXPECTED_PI_VERSION"
    fi
else
    fail "Pi is not installed at $pi_binary"
fi

pi_auth_file="$HOME/.pi/agent/auth.json"
if [[ -e $pi_auth_file ]]; then
    auth_mode=$(stat -c '%a' "$pi_auth_file")
    if [[ $auth_mode == 600 ]]; then
        pass "Pi authentication file permissions are 0600"
    else
        fail "Pi authentication file permissions are $auth_mode instead of 600"
    fi
else
    warn "Pi is not authenticated yet; run pi and then /login"
fi

section "Disks"
lsblk -o NAME,TYPE,SIZE,FSTYPE,MOUNTPOINTS
if sudo -n true 2>/dev/null; then
    while read -r disk; do
        [[ -n $disk ]] || continue
        if sudo -n smartctl -H "/dev/$disk" 2>/dev/null | grep -Eq 'PASSED|OK'; then
            pass "SMART health passed for /dev/$disk"
        else
            warn "SMART health was unavailable or did not pass for /dev/$disk"
        fi
    done < <(lsblk -dn -o NAME,TYPE | awk '$2 == "disk" {print $1}')
fi

section "Network"
ip -brief address
ip route show default
if getent hosts github.com >/dev/null; then
    pass "DNS resolution works"
else
    fail "DNS resolution failed"
fi

if (( failures > 0 )); then
    printf '\nDoctor found %d failure(s).\n' "$failures" >&2
    exit 1
fi
printf '\nDoctor found no base-system failures.\n'
