#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
EXPECTED_NODE_VERSION=$(awk -F'"' '/^server_config_node_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_PI_VERSION=$(awk -F'"' '/^server_config_pi_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_CODEX_VERSION=$(awk -F'"' '/^server_config_codex_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_HERDR_VERSION=$(awk -F'"' '/^server_config_herdr_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_ONBOARDING_VERSION=$(awk -F'"' '/^server_config_onboarding_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_SWAP_PATH=$(awk '/^server_config_swap_path:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_MOSH_PORT_RANGE=$(awk -F'"' '/^server_config_mosh_port_range:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_TRANSMISSION_RPC_PORT=$(awk '/^server_config_transmission_rpc_port:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_TRANSMISSION_PEER_PORT=$(awk '/^server_config_transmission_peer_port:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_TRANSMISSION_UPLOAD_LIMIT=$(awk '/^server_config_transmission_upload_limit_kbps:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_TRANSMISSION_DOWNLOAD_DIR="$HOME/Downloads/Torrents"
EXPECTED_CITADEL_ENABLED=$(awk '/^server_config_citadel_enabled:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_CITADEL_PORT=$(awk '/^server_config_citadel_port:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_DOCKER_VERSION=$(awk -F'"' '/^server_config_docker_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_DOCKER_COMPOSE_VERSION=$(awk -F'"' '/^server_config_docker_compose_version:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_ANDROID_ENABLED=$(awk '/^server_config_android_enabled:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
EXPECTED_MAINTENANCE_WINDOW_MAX=$(awk '/^server_config_maintenance_window_max_minutes:/ {print $2}' "$ROOT_DIR/group_vars/all.yml")
MAINTENANCE_WINDOW_SOCKET=/run/server-config-maintenance-window/window.sock
MAINTENANCE_WINDOW_BINARY=/usr/local/bin/server-config-window
MAINTENANCE_WINDOW_UNIT=/etc/systemd/system/server-config-maintenance-window@.service
failures=0

section() {
    printf '\n== %s ==\n' "$1"
}

pass() {
    printf '[ok] %s\n' "$1"
}

warn() {
    printf '[warn] %s\n' "$1"
}

fail() {
    printf '[fail] %s\n' "$1" >&2
    failures=$((failures + 1))
}

[[ $(uname -s) == Linux ]] || {
    printf 'error: doctor runs on the managed Linux host\n' >&2
    exit 1
}

section "System"
# shellcheck source=/dev/null
. /etc/os-release
printf 'OS: %s %s\n' "${NAME:-unknown}" "${VERSION_ID:-unknown}"
printf 'Kernel: %s\n' "$(uname -r)"
printf 'Architecture: %s\n' "$(uname -m)"
printf 'Hostname: %s\n' "$(hostname)"
if [[ ${ID:-} == ubuntu && ${VERSION_ID:-} == 24.04 ]]; then
    pass "supported Ubuntu release"
else
    fail "expected Ubuntu 24.04"
fi
if [[ $(uname -m) == x86_64 ]]; then
    pass "supported architecture"
else
    fail "expected x86_64"
fi

section "CPU and KVM"
awk -F: '/model name/ {sub(/^[ \t]+/, "", $2); print "CPU: " $2; exit}' /proc/cpuinfo
printf 'Logical CPUs: %s\n' "$(getconf _NPROCESSORS_ONLN)"
if grep -Eq '^flags.*\b(vmx|svm)\b' /proc/cpuinfo; then
    pass "hardware virtualization flag present"
else
    fail "hardware virtualization flag missing"
fi
if [[ -e /dev/kvm ]]; then
    if [[ -r /dev/kvm && -w /dev/kvm ]]; then
        pass "/dev/kvm is usable by this user"
    else
        warn "/dev/kvm exists but this user cannot use it yet"
    fi
else
    warn "/dev/kvm is not available yet"
fi

section "RAID and filesystems"
cat /proc/mdstat
if grep -Eq '\[[U_]*_[U_]*\]' /proc/mdstat; then
    fail "a software RAID member is missing"
else
    pass "no degraded software RAID marker found"
fi
for mount_point in /boot /; do
    findmnt -no SOURCE,FSTYPE,SIZE,USED,AVAIL,TARGET "$mount_point" 2>/dev/null || fail "$mount_point is not mounted"
done
if sudo -n true 2>/dev/null; then
    sudo -n mdadm --detail --scan || true
else
    warn "run sudo -v before doctor for mdadm and SMART details"
fi

df -h / /boot

section "Memory and swap"
free -h
if swapon --show=NAME --noheadings | grep -Fxq "$EXPECTED_SWAP_PATH"; then
    pass "$EXPECTED_SWAP_PATH is active"
else
    fail "$EXPECTED_SWAP_PATH is not active"
fi

section "Timers and updates"
for unit in fstrim.timer apt-daily.timer apt-daily-upgrade.timer; do
    if systemctl is-enabled --quiet "$unit" && systemctl is-active --quiet "$unit"; then
        pass "$unit is enabled and active"
    else
        fail "$unit is not enabled and active"
    fi
done
if [[ -e /var/run/reboot-required ]]; then
    warn "a reboot is required"
else
    pass "no reboot is currently required"
fi

section "Private access"
for unit in tailscaled ufw ssh.socket; do
    if systemctl is-enabled --quiet "$unit" && systemctl is-active --quiet "$unit"; then
        pass "$unit is enabled and active"
    else
        fail "$unit is not enabled and active"
    fi
done
if tailscale_ip=$(tailscale ip -4 2>/dev/null | head -1) && [[ $tailscale_ip == 100.* ]]; then
    printf 'Tailscale IPv4: %s\n' "$tailscale_ip"
    pass "Tailscale is connected"
else
    fail "Tailscale has no IPv4 address"
fi
if tailscale debug prefs 2>/dev/null | jq -e '.RunSSH == false' >/dev/null; then
    pass "Tailscale SSH is disabled"
else
    fail "Tailscale SSH is enabled or its state is unavailable"
fi
if dpkg-query -W -f='${db:Status-Status}' mosh 2>/dev/null | grep -qx installed \
    && command -v mosh-server >/dev/null 2>&1; then
    pass "Mosh is installed"
else
    fail "Mosh is not installed"
fi
if dpkg-query -W -f='${db:Status-Status}' bind9 2>/dev/null | grep -qx installed; then
    fail "the unused bind9 server is installed"
else
    pass "bind9 is absent"
fi
if pgrep -x named >/dev/null; then
    fail "named is running"
else
    pass "named is not running"
fi
if sudo -n true 2>/dev/null; then
    ufw_status=$(sudo -n ufw status verbose)
    if grep -q '^Status: active$' <<<"$ufw_status"; then
        pass "UFW is active"
    else
        fail "UFW is inactive"
    fi
    if grep -q '22/tcp on tailscale0' <<<"$ufw_status"; then
        pass "SSH is allowed on tailscale0"
    else
        fail "SSH is not allowed on tailscale0"
    fi
    if grep -Fq "$EXPECTED_MOSH_PORT_RANGE/udp on tailscale0" <<<"$ufw_status"; then
        pass "Mosh is allowed on tailscale0"
    else
        fail "Mosh is not allowed on tailscale0"
    fi
    for protocol in tcp udp; do
        if grep -Fq "$EXPECTED_TRANSMISSION_PEER_PORT/$protocol" <<<"$ufw_status"; then
            pass "Transmission peer traffic is allowed over $protocol"
        else
            fail "Transmission peer traffic is not allowed over $protocol"
        fi
    done
    if grep -q '1022/tcp' <<<"$ufw_status"; then
        fail "the temporary release-upgrade SSH rule is still present"
    else
        pass "the temporary release-upgrade SSH rule is absent"
    fi
else
    warn "run sudo -v before doctor to inspect the effective UFW rules"
fi

section "Shell"
login_shell=$(getent passwd "$USER" | cut -d: -f7)
if [[ $login_shell == /usr/bin/zsh ]]; then
    pass "Zsh is the login shell"
else
    fail "the login shell is $login_shell instead of /usr/bin/zsh"
fi
if [[ -L $HOME/.zshenv && -L $HOME/.config/zsh && -L $HOME/.config/ohmyposh/zen.toml ]]; then
    pass "shell configuration is linked to server-config"
else
    fail "one or more shell configuration paths are not symlinks"
fi
if /usr/bin/zsh -lic 'command -v mise >/dev/null && command -v nvim >/dev/null' >/dev/null 2>&1; then
    pass "managed Zsh starts with the mise toolchain"
else
    fail "managed Zsh startup failed"
fi
if [[ -L $HOME/.config/nvim ]]; then
    pass "Neovim configuration is linked to server-config"
else
    fail "Neovim configuration is not linked to server-config"
fi
if [[ -f $HOME/.local/share/nvim/site/parser/lua.so ]] \
    && nvim --headless '+lua assert(vim.fn.exists(":Lazy") == 2)' +qa >/dev/null 2>&1; then
    pass "headless Neovim startup and parser installation succeed"
else
    fail "headless Neovim startup or parser installation failed"
fi

section "User toolchain"
if command -v mise >/dev/null 2>&1; then
    printf 'mise: %s\n' "$(mise --version)"
    if mise install --dry-run-code >/dev/null 2>&1; then
        pass "all pinned mise tools are installed"
    else
        fail "one or more pinned mise tools are missing"
    fi
else
    fail "mise is not available"
fi

for command_name in rustc cargo gh eas vercel nvim; do
    if command -v "$command_name" >/dev/null 2>&1; then
        printf '%s: %s\n' "$command_name" "$($command_name --version 2>&1 | head -1)"
    else
        fail "$command_name is not available"
    fi
done

section "Transmission"
transmission_package_count=$(dpkg-query -W -f='${db:Status-Status}\n' \
    transmission-daemon transmission-cli 2>/dev/null | grep -c '^installed$' || true)
if [[ $transmission_package_count -eq 2 ]]; then
    printf 'Transmission: %s\n' "$(transmission-daemon --version 2>&1 | head -1)"
    pass "Transmission daemon and control tools are installed"
else
    fail "Transmission daemon or control tools are missing"
fi
if systemctl is-enabled --quiet transmission-daemon.service \
    && systemctl is-active --quiet transmission-daemon.service; then
    pass "transmission-daemon.service is enabled and active"
else
    fail "transmission-daemon.service is not enabled and active"
fi
if [[ -d $EXPECTED_TRANSMISSION_DOWNLOAD_DIR && -w $EXPECTED_TRANSMISSION_DOWNLOAD_DIR ]]; then
    pass "Transmission downloads are available to the managed user"
else
    fail "Transmission downloads are unavailable at $EXPECTED_TRANSMISSION_DOWNLOAD_DIR"
fi
rpc_listeners=$(ss -H -ltn "sport = :$EXPECTED_TRANSMISSION_RPC_PORT")
if [[ $(wc -l <<<"$rpc_listeners") -eq 1 ]] \
    && grep -Fq "127.0.0.1:$EXPECTED_TRANSMISSION_RPC_PORT" <<<"$rpc_listeners"; then
    pass "Transmission RPC listens only on IPv4 loopback"
else
    fail "Transmission RPC is missing or listens beyond IPv4 loopback"
fi
if transmission_session=$(transmission-remote \
    "127.0.0.1:$EXPECTED_TRANSMISSION_RPC_PORT" --json --session-info 2>/dev/null) \
    && jq -e \
        --arg downloadDir "$EXPECTED_TRANSMISSION_DOWNLOAD_DIR" \
        --argjson peerPort "$EXPECTED_TRANSMISSION_PEER_PORT" \
        --argjson uploadLimit "$EXPECTED_TRANSMISSION_UPLOAD_LIMIT" \
        '.result == "success"
            and .arguments["download-dir"] == $downloadDir
            and .arguments["peer-port"] == $peerPort
            and .arguments["port-forwarding-enabled"] == false
            and .arguments["speed-limit-up-enabled"] == true
            and .arguments["speed-limit-up"] == $uploadLimit' \
        <<<"$transmission_session" >/dev/null; then
    pass "Transmission session settings match server-config"
else
    fail "Transmission session settings do not match server-config"
fi
if ss -H -ltn "sport = :$EXPECTED_TRANSMISSION_PEER_PORT" | grep -q . \
    && ss -H -lun "sport = :$EXPECTED_TRANSMISSION_PEER_PORT" | grep -q .; then
    pass "Transmission listens for TCP and UDP peers"
else
    fail "Transmission is not listening for both TCP and UDP peers"
fi

section "Developer identity"
if git config --global --includes --get user.name >/dev/null 2>&1 \
    && git config --global --includes --get user.email >/dev/null 2>&1; then
    pass "Git name and email are configured"
else
    warn "Git identity is missing; run ./bin/onboard"
fi

section "Interactive onboarding"
onboarding_binary="$HOME/.local/bin/server-onboarding"
if [[ -x $onboarding_binary ]]; then
    installed_onboarding_version=$($onboarding_binary --version)
    printf 'Onboarding: %s\n' "$installed_onboarding_version"
    if [[ $installed_onboarding_version == "server-onboarding $EXPECTED_ONBOARDING_VERSION" ]] \
        && SERVER_CONFIG_ROOT="$ROOT_DIR" "$onboarding_binary" --status >/dev/null 2>&1; then
        pass "onboarding TUI and status checks are available"
    else
        fail "onboarding TUI verification failed"
    fi
else
    fail "onboarding TUI is not installed at $onboarding_binary"
fi

section "Codex runtime"
codex_binary="$HOME/.local/bin/codex"
if [[ -x $codex_binary ]]; then
    installed_codex_version=$($codex_binary --version)
    printf 'Codex: %s\n' "$installed_codex_version"
    if [[ $installed_codex_version == "codex-cli $EXPECTED_CODEX_VERSION" ]]; then
        pass "Codex matches the pinned version"
    else
        fail "Codex does not match the pinned version $EXPECTED_CODEX_VERSION"
    fi
    if remote_control_help=$($codex_binary remote-control --help 2>&1) \
        && grep -Eq '^[[:space:]]+pair[[:space:]]' <<<"$remote_control_help"; then
        pass "Codex experimental remote-control pairing is available"
    else
        fail "Codex experimental remote-control pairing is unavailable"
    fi
else
    fail "Codex is not installed at $codex_binary"
fi
if command -v bwrap >/dev/null 2>&1; then
    printf 'Bubblewrap: %s\n' "$(bwrap --version)"
    pass "bubblewrap is installed"
else
    fail "bubblewrap is not installed"
fi
if [[ -f /etc/apparmor.d/bwrap-userns-restrict ]]; then
    pass "the bubblewrap AppArmor profile is installed"
else
    fail "the bubblewrap AppArmor profile is missing"
fi
if [[ -x $codex_binary ]] && $codex_binary sandbox /usr/bin/true >/dev/null 2>&1; then
    pass "the Codex Linux sandbox can run a command"
else
    fail "the Codex Linux sandbox cannot run a command"
fi

codex_auth_file="$HOME/.codex/auth.json"
if [[ -e $codex_auth_file ]]; then
    codex_auth_mode=$(stat -c '%a' "$codex_auth_file")
    if [[ $codex_auth_mode == 600 ]]; then
        pass "Codex authentication file permissions are 0600"
    else
        fail "Codex authentication file permissions are $codex_auth_mode instead of 600"
    fi
elif [[ -x $codex_binary ]] && $codex_binary login status >/dev/null 2>&1; then
    pass "Codex authentication is available from the credential store"
else
    warn "Codex is not authenticated yet; run codex login --device-auth"
fi

section "Pi skills"
pi_skills="$HOME/.pi/agent/skills"
if [[ -L $pi_skills && $(readlink "$pi_skills") == "$ROOT_DIR/config/pi/skills" ]]; then
    pass "Pi skills are linked to server-config"
else
    fail "Pi skills are not linked to server-config"
fi
for skill_name in three-stage-workflow unslop; do
    if [[ -f $pi_skills/$skill_name/SKILL.md ]]; then
        pass "$skill_name skill is installed"
    else
        fail "$skill_name skill is missing"
    fi
done

section "Pi runtime"
if command -v node >/dev/null 2>&1; then
    installed_node_version=$(node --version)
    printf 'Node.js: %s\n' "$installed_node_version"
    if [[ ${installed_node_version#v} == "$EXPECTED_NODE_VERSION" ]]; then
        pass "Node.js matches the pinned version"
    else
        fail "Node.js does not match the pinned version $EXPECTED_NODE_VERSION"
    fi
else
    fail "Node.js is not available"
fi

pi_binary="$HOME/.local/bin/pi"
if [[ -x $pi_binary ]]; then
    installed_pi_version=$($pi_binary --version)
    printf 'Pi: %s\n' "$installed_pi_version"
    if [[ $installed_pi_version == "$EXPECTED_PI_VERSION" ]]; then
        pass "Pi matches the pinned version"
    else
        fail "Pi does not match the pinned version $EXPECTED_PI_VERSION"
    fi
else
    fail "Pi is not installed at $pi_binary"
fi

herdr_binary="$HOME/.local/bin/herdr"
if [[ -x $herdr_binary ]]; then
    installed_herdr_version=$($herdr_binary --version)
    printf 'Herdr: %s\n' "$installed_herdr_version"
    if [[ $installed_herdr_version == "herdr $EXPECTED_HERDR_VERSION" ]]; then
        pass "Herdr matches the pinned version"
    else
        fail "Herdr does not match the pinned version $EXPECTED_HERDR_VERSION"
    fi
else
    fail "Herdr is not installed at $herdr_binary"
fi

pi_auth_file="$HOME/.pi/agent/auth.json"
if [[ -e $pi_auth_file ]]; then
    auth_mode=$(stat -c '%a' "$pi_auth_file")
    if [[ $auth_mode == 600 ]]; then
        pass "Pi authentication file permissions are 0600"
    else
        fail "Pi authentication file permissions are $auth_mode instead of 600"
    fi
else
    warn "Pi is not authenticated yet; run pi and then /login"
fi

section "Rootless Docker"
docker_binary=/usr/local/bin/docker
managed_docker_socket="unix:///run/server-config-docker/$USER/docker.sock"
if [[ -x $docker_binary ]]; then
    installed_docker_version=$($docker_binary --version)
    printf 'Docker: %s\n' "$installed_docker_version"
    if [[ $installed_docker_version == *"Docker version $EXPECTED_DOCKER_VERSION,"* ]]; then
        pass "Docker matches the pinned version"
    else
        fail "Docker does not match the pinned version $EXPECTED_DOCKER_VERSION"
    fi
    installed_compose_version=$($docker_binary compose version --short 2>/dev/null || true)
    if [[ $installed_compose_version == "$EXPECTED_DOCKER_COMPOSE_VERSION" ]]; then
        pass "Docker Compose matches the pinned version"
    else
        fail "Docker Compose does not match the pinned version $EXPECTED_DOCKER_COMPOSE_VERSION"
    fi
else
    fail "Docker is not installed at $docker_binary"
fi
docker_unit="server-config-docker@$USER.service"
if systemctl is-enabled --quiet "$docker_unit" && systemctl is-active --quiet "$docker_unit"; then
    pass "$docker_unit is enabled and active"
else
    fail "$docker_unit is not enabled and active"
fi
if [[ -x $docker_binary ]] \
    && docker_security=$(DOCKER_HOST="$managed_docker_socket" $docker_binary info --format '{{json .SecurityOptions}}' 2>/dev/null) \
    && [[ $docker_security == *name=rootless* ]]; then
    pass "the managed user's Docker daemon is rootless"
else
    fail "the managed user's rootless Docker daemon is unavailable"
fi
if docker_cgroup_driver=$(DOCKER_HOST="$managed_docker_socket" $docker_binary info --format '{{.CgroupDriver}}' 2>/dev/null) \
    && [[ $docker_cgroup_driver == none || $docker_cgroup_driver == cgroupfs ]]; then
    pass "rootless containers avoid privileged systemd cgroup scopes"
else
    fail "rootless Docker uses an unavailable systemd cgroup scope"
fi
if [[ -S /var/run/docker.sock ]]; then
    fail "the rootful Docker socket exists"
else
    pass "the rootful Docker socket is absent"
fi
if [[ -e /proc/sys/net/bridge/bridge-nf-call-iptables ]]; then
    pass "bridge netfilter is available to Docker"
else
    fail "bridge netfilter is unavailable to Docker"
fi

section "Application boundary"
if [[ -e /usr/local/bin/multica || -e /usr/local/bin/multica-run \
    || -e /etc/systemd/system/multica-daemon.service \
    || -e /etc/systemd/system/multica-project-sync.timer ]]; then
    fail "retired host-managed Multica files remain installed"
else
    pass "application commands and services are not installed system-wide"
fi
if getent passwd multica >/dev/null || grep -Eq '^multica:' /etc/subuid /etc/subgid; then
    fail "the retired dedicated Multica account or subordinate IDs remain"
else
    pass "the retired dedicated Multica identity is absent"
fi
expected_git_excludes=\~/.config/git/ignore
if git config --global --get core.excludesfile 2>/dev/null | grep -Fxq "$expected_git_excludes" \
    && grep -Fxq '.multica/' "$HOME/.config/git/ignore" 2>/dev/null; then
    pass "the global Git ignore excludes project-local Multica memory"
else
    fail "the global Git ignore does not exclude project-local Multica memory"
fi

if [[ $EXPECTED_ANDROID_ENABLED == true ]]; then
    section "Android QA prerequisites"
    for command_path in \
        /opt/android-sdk/cmdline-tools/latest/bin/sdkmanager \
        /opt/android-sdk/platform-tools/adb \
        /opt/android-sdk/emulator/emulator; do
        if [[ -x $command_path ]]; then
            pass "$command_path is installed"
        else
            fail "$command_path is missing"
        fi
    done
    if java -version 2>&1 | head -1 | grep -q 'version "21'; then
        pass "Java 21 is active"
    else
        fail "Java 21 is not active"
    fi
    if id -nG "$USER" | grep -Eq '(^| )kvm( |$)'; then
        pass "the managed user can use KVM"
    else
        fail "the managed user is not in the kvm group"
    fi
fi

section "Maintenance window"
if [[ $EXPECTED_MAINTENANCE_WINDOW_MAX == 480 ]]; then
    pass "maintenance windows have an eight-hour maximum"
else
    fail "maintenance-window maximum is not eight hours"
fi
if [[ -x $MAINTENANCE_WINDOW_BINARY \
    && $(stat -c '%U:%G:%a' "$MAINTENANCE_WINDOW_BINARY") == root:root:755 ]]; then
    pass "maintenance-window broker is installed as root:root 0755"
else
    fail "maintenance-window broker is missing or has unexpected ownership"
fi
if [[ -f $MAINTENANCE_WINDOW_UNIT \
    && $(stat -c '%U:%G:%a' "$MAINTENANCE_WINDOW_UNIT") == root:root:644 ]]; then
    pass "maintenance-window systemd template is installed as root:root 0644"
else
    fail "maintenance-window systemd template is missing or has unexpected ownership"
fi
if [[ -S $MAINTENANCE_WINDOW_SOCKET ]]; then
    warn "a server-config maintenance window is open"
else
    pass "no server-config maintenance window is open"
fi

if [[ $EXPECTED_CITADEL_ENABLED == true ]]; then
    section "Citadel"
    citadel_unit="citadel@$USER.service"
    if systemctl is-enabled --quiet "$citadel_unit" && systemctl is-active --quiet "$citadel_unit"; then
        pass "$citadel_unit is enabled and active"
    else
        fail "$citadel_unit is not enabled and active"
    fi
    if citadel_health=$(curl --fail --silent --show-error \
        "http://127.0.0.1:$EXPECTED_CITADEL_PORT/api/health" 2>/dev/null) \
        && jq -e '.status == "ok"' <<<"$citadel_health" >/dev/null; then
        pass "Citadel localhost health check passed"
    else
        fail "Citadel localhost health check failed"
    fi
    if [[ -S $MAINTENANCE_WINDOW_SOCKET ]]; then
        citadel_processes=$(supervisorctl \
            -c "$HOME/.local/state/citadel/supervisord.conf" status 2>/dev/null || true)
        active_managed_services=$(awk \
            '$2 == "RUNNING" && $1 != "citadel-dashboard" { print $1 }' \
            <<<"$citadel_processes")
        if ! grep -Eq '^citadel-dashboard[[:space:]]+RUNNING' <<<"$citadel_processes"; then
            fail "Citadel Supervisor status is unavailable during the maintenance window"
        elif [[ -z $active_managed_services ]]; then
            pass "Citadel managed services are suspended during the maintenance window"
        else
            fail "Citadel managed services remain active: $active_managed_services"
        fi
    fi
    if systemctl is-enabled --quiet supervisor.service 2>/dev/null; then
        fail "the distribution Supervisor service is enabled"
    else
        pass "the distribution Supervisor service is disabled"
    fi
    if systemctl is-active --quiet supervisor.service; then
        fail "the distribution Supervisor service is active"
    else
        pass "the distribution Supervisor service is stopped"
    fi
fi

section "Disks"
lsblk -o NAME,TYPE,SIZE,FSTYPE,MOUNTPOINTS
if sudo -n true 2>/dev/null; then
    while read -r disk; do
        [[ -n $disk ]] || continue
        if sudo -n smartctl -H "/dev/$disk" 2>/dev/null | grep -Eq 'PASSED|OK'; then
            pass "SMART health passed for /dev/$disk"
        else
            warn "SMART health was unavailable or did not pass for /dev/$disk"
        fi
    done < <(lsblk -dn -o NAME,TYPE | awk '$2 == "disk" {print $1}')
fi

section "Network"
ip -brief address
ip route show default
if getent hosts github.com >/dev/null; then
    pass "DNS resolution works"
else
    fail "DNS resolution failed"
fi

if (( failures > 0 )); then
    printf '\nDoctor found %d failure(s).\n' "$failures" >&2
    exit 1
fi
printf '\nDoctor found no base-system failures.\n'
