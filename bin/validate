#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT_DIR"

missing=()
for command_name in ansible-lint ansible-playbook apparmor_parser python3 shellcheck yamllint zsh; do
    command -v "$command_name" >/dev/null 2>&1 || missing+=("$command_name")
done
if (( ${#missing[@]} > 0 )); then
    printf 'error: missing validation commands: %s\n' "${missing[*]}" >&2
    printf 'on Ubuntu, run: sudo apt-get install ansible-core ansible-lint shellcheck yamllint\n' >&2
    exit 1
fi

shellcheck install.sh bin/apply bin/check bin/converge bin/doctor bin/onboard bin/validate \
    files/multica-heavy-run tests/check-maintenance-window.sh
zsh -n config/zsh/zshenv config/zsh/.zshrc config/zsh/*.zsh
python3 -m json.tool config/pi/settings.desired.json >/dev/null
python3 -m json.tool config/multica/pi-settings.json >/dev/null
python3 -m json.tool config/nvim/lazy-lock.json >/dev/null
test -x files/server-config-window
test -x files/multica-bootstrap
test -x files/multica-heavy-run
test -x files/multica-project-config
test -x files/multica-project-sync
test -x files/multica-run
test -x tests/check-maintenance-window.sh
python3 -m py_compile \
    files/server-config-window \
    files/multica-bootstrap \
    files/multica-project-config \
    files/multica-project-sync \
    files/multica-run \
    files/multica_project.py \
    tests/test_maintenance_window.py \
    tests/test_multica_project.py
python3 -W error -m unittest discover -s tests -p 'test_*.py'
python3 - <<'PY'
from pathlib import Path
import subprocess
import tempfile

from jinja2 import Environment, StrictUndefined

template = Environment(undefined=StrictUndefined).from_string(
    Path("templates/multica-android-emulator.j2").read_text()
)
rendered = template.render(
    server_config_android_sdk_root="/opt/android-sdk",
    server_config_android_avd_name="multica-api-35",
)
subprocess.run(["bash", "-n", "-"], input=rendered, text=True, check=True)
subprocess.run(["shellcheck", "--shell=bash", "-"], input=rendered, text=True, check=True)

docker_unit = Environment(undefined=StrictUndefined).from_string(
    Path("templates/server-config-docker@.service.j2").read_text()
).render(
    server_config_docker_install_dir="/opt/server-config/docker/29.1.3",
    server_config_docker_runtime_dir="/run/server-config-docker",
)
assert "--exec-opt=native.cgroupdriver=cgroupfs" in docker_unit

profile = Environment(undefined=StrictUndefined).from_string(
    Path("templates/server-config-rootlesskit.apparmor.j2").read_text()
).render(server_config_docker_install_dir="/opt/server-config/docker/29.1.3")
with tempfile.NamedTemporaryFile(mode="w") as file:
    file.write(profile)
    file.flush()
    subprocess.run(
        ["apparmor_parser", "--skip-kernel-load", "--skip-read-cache", file.name],
        check=True,
    )
PY
./tests/check-maintenance-window.sh
python3 -c 'import tomllib; tomllib.load(open("config/herdr/config.toml", "rb")); tomllib.load(open("config/mise/config.toml", "rb")); tomllib.load(open("config/nvim/stylua.toml", "rb")); tomllib.load(open("config/ohmyposh/zen.toml", "rb")); tomllib.load(open("onboarding/Cargo.toml", "rb"))'
test -s onboarding/Cargo.lock
if command -v cargo >/dev/null 2>&1; then
    cargo fmt --manifest-path onboarding/Cargo.toml --check
fi
python3 - <<'PY'
from pathlib import Path
import re

skills_root = Path("config/pi/skills")
skills = sorted(skills_root.glob("*/SKILL.md"))
assert [path.parent.name for path in skills] == ["three-stage-workflow", "unslop"], "unexpected Pi skills"
for path in skills:
    content = path.read_text()
    assert content.startswith("---\n"), f"{path} has no frontmatter"
    _, frontmatter, body = content.split("---", 2)
    fields = {}
    for line in frontmatter.strip().splitlines():
        key, value = line.split(":", 1)
        fields[key.strip()] = value.strip()
    name = fields.get("name", "")
    description = fields.get("description", "")
    assert name == path.parent.name, f"{path} name does not match its directory"
    assert re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name), f"{path} has an invalid name"
    assert 1 <= len(name) <= 64, f"{path} name is too long"
    assert 1 <= len(description) <= 1024, f"{path} description is missing or too long"
    assert body.strip(), f"{path} has no instructions"
PY
python3 - <<'PY'
from pathlib import Path
import re
import yaml

variables = Path("group_vars/all.yml").read_text()
version_match = re.search(r'^server_config_multica_version: "([^"]+)"$', variables, re.MULTILINE)
assert version_match, "Multica version is missing"
version = version_match.group(1)
compose = yaml.safe_load(Path("config/multica/compose.override.yml").read_text())
assert compose["services"]["backend"]["image"].endswith(f":v{version}"), "backend image version drift"
assert compose["services"]["frontend"]["image"].endswith(f":v{version}"), "frontend image version drift"
assert compose["services"]["proxy"]["ports"] == ["127.0.0.1:4180:4180"], "proxy must stay on loopback"

agent_root = Path("config/multica/agents")
assert sorted(path.name for path in agent_root.glob("*.md")) == [
    "common.md", "giselle.md", "karina.md", "ningning.md", "winter.md"
], "unexpected Multica agent instruction files"
for path in agent_root.glob("*.md"):
    content = path.read_text()
    assert content.strip(), f"{path} is empty"
    assert "--no-context-files" not in content, f"{path} disables the Multica runtime brief"
    assert "--no-skills" not in content, f"{path} disables Multica skills"
PY
systemd-analyze calendar '*-*-* 08:00:00 Europe/Paris' '*-*-* 20:00:00 Europe/Paris' >/dev/null
python3 - <<'PY'
import os
from pathlib import Path
import subprocess

identity = Path("config/git/identity.local")
if identity.exists():
    assert identity.is_file(), "config/git/identity.local must be a regular file"
    assert identity.stat().st_mode & 0o777 == 0o600, "config/git/identity.local must use mode 0600"
    keys = subprocess.run(
        ["git", "config", "--file", str(identity), "--name-only", "--list"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.splitlines()
    assert sorted(keys) == ["user.email", "user.name"], "local Git identity has unexpected keys"
PY
yamllint .ansible-lint .yamllint config/multica/compose.override.yml group_vars/all.yml inventory/localhost.yml playbook.yml tasks/*.yml
ansible-playbook --syntax-check playbook.yml
ansible-lint playbook.yml

git diff --check
printf 'Validation passed.\n'
