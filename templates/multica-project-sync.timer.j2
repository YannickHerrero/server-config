[Unit]
Description=Synchronize Multica projects at 08:00 and 20:00 Europe/Paris

[Timer]
OnCalendar=*-*-* 08:00:00 {{ server_config_multica_timezone }}
OnCalendar=*-*-* 20:00:00 {{ server_config_multica_timezone }}
Persistent=true
RandomizedDelaySec=5m
AccuracySec=1m
Unit=multica-project-sync.service

[Install]
WantedBy=timers.target
