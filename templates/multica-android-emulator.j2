#!/usr/bin/env bash
set -Eeuo pipefail

sdk='{{ server_config_android_sdk_root }}'
avd='{{ server_config_android_avd_name }}'
state_dir=${MULTICA_PROCESS_STATE:-"$HOME/.local/state/multica/processes"}
export ANDROID_HOME="$sdk"
export ANDROID_SDK_ROOT="$sdk"
export PATH="$sdk/platform-tools:$sdk/emulator:$sdk/cmdline-tools/latest/bin:/usr/bin:/bin"
mkdir -p -- "$state_dir"
chmod 0700 -- "$state_dir"

single_emulator() {
    local devices
    mapfile -t devices < <(adb devices | awk '$1 ~ /^emulator-/ && $2 == "device" {print $1}')
    if (( ${#devices[@]} != 1 )); then
        printf 'error: expected one online emulator, found %d\n' "${#devices[@]}" >&2
        return 1
    fi
    printf '%s\n' "${devices[0]}"
}

case "${1:-}" in
    start)
        exec /usr/bin/flock --exclusive --nonblock "$state_dir/android-emulator.lock" \
            "$sdk/emulator/emulator" \
            -avd "$avd" \
            -no-window \
            -no-audio \
            -no-boot-anim \
            -gpu swiftshader_indirect \
            -no-snapshot
        ;;
    wait)
        timeout=${2:-180}
        deadline=$((SECONDS + timeout))
        adb wait-for-device
        while (( SECONDS < deadline )); do
            if [[ $(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r') == 1 ]]; then
                adb shell input keyevent 82 >/dev/null 2>&1 || true
                printf 'Android emulator is ready.\n'
                exit 0
            fi
            sleep 2
        done
        printf 'error: Android emulator did not boot within %ss\n' "$timeout" >&2
        exit 1
        ;;
    stop)
        serial=$(single_emulator)
        exec adb -s "$serial" emu kill
        ;;
    screenshot)
        [[ -n ${2:-} ]] || {
            printf 'usage: multica-android-emulator screenshot <output.png>\n' >&2
            exit 2
        }
        serial=$(single_emulator)
        exec adb -s "$serial" exec-out screencap -p >"$2"
        ;;
    logcat)
        serial=$(single_emulator)
        shift
        exec adb -s "$serial" logcat "$@"
        ;;
    status)
        adb devices -l
        ;;
    *)
        printf 'usage: multica-android-emulator {start|wait [seconds]|stop|screenshot <file>|logcat [args]|status}\n' >&2
        exit 2
        ;;
esac
