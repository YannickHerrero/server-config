#!/usr/bin/env bash
set -Eeuo pipefail

export DOCKER_HOST='unix://{{ server_config_docker_runtime_dir }}/{{ ansible_user_id }}/docker.sock'
project_dir='{{ server_config_multica_repo_dir }}'
env_file='{{ server_config_multica_env_file }}'
compose=(
    /usr/local/bin/docker compose
    --project-directory "$project_dir"
    --env-file "$env_file"
    -f "$project_dir/docker-compose.selfhost.yml"
    -f "$project_dir/runtime/compose.override.yml"
)

case "${1:-}" in
    foreground)
        exec "${compose[@]}" up --remove-orphans
        ;;
    up)
        exec "${compose[@]}" up --detach --remove-orphans
        ;;
    pull)
        exec "${compose[@]}" pull
        ;;
    ps)
        exec "${compose[@]}" ps
        ;;
    logs)
        shift
        exec "${compose[@]}" logs "$@"
        ;;
    verification-code)
        "${compose[@]}" logs backend | grep 'Verification code' | tail -n 1
        ;;
    health)
        exec /usr/bin/curl --fail --silent --show-error http://127.0.0.1:{{ server_config_multica_proxy_port }}/readyz
        ;;
    config)
        exec "${compose[@]}" config --quiet
        ;;
    down)
        exec "${compose[@]}" down
        ;;
    *)
        printf 'usage: multica-server {foreground|up|pull|ps|logs|verification-code|health|config|down}\n' >&2
        exit 2
        ;;
esac
