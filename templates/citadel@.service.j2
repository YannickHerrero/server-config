[Unit]
Description=Citadel service controller for %i
Documentation=file:///home/%i/dev/citadel/README.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/dev/citadel
Environment=HOME=/home/%i
Environment=PATH=/home/%i/.local/share/mise/shims:/home/%i/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/test -r /home/%i/.local/state/citadel/supervisord.conf
ExecStart=/usr/bin/env supervisord -n -c /home/%i/.local/state/citadel/supervisord.conf
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillMode=process
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
