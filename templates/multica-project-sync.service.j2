[Unit]
Description=Synchronize local development repositories with Multica
After=network-online.target multica-daemon.service
Wants=network-online.target
ConditionPathExists={{ server_config_multica_home }}/.multica/config.json

[Service]
Type=oneshot
User={{ server_config_multica_user }}
Group={{ server_config_multica_user }}
WorkingDirectory={{ server_config_multica_home }}
Environment=HOME={{ server_config_multica_home }}
Environment=PATH={{ server_config_multica_home }}/.local/share/mise/shims:{{ server_config_multica_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=MULTICA_DEV_ROOT={{ ansible_user_dir }}/dev
Environment=MULTICA_PROJECT_MAP={{ server_config_multica_project_map }}
ExecStart=/usr/local/bin/multica-project-sync
TimeoutStartSec=30m
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ server_config_multica_home }}/.local/state/multica {{ ansible_user_dir }}/dev
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
