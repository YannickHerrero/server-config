[Unit]
Description=Multica Pi agent daemon
Documentation=https://multica.ai/docs/daemon-runtimes
After=network-online.target tailscaled.service server-config-docker@{{ server_config_multica_user }}.service
Wants=network-online.target server-config-docker@{{ server_config_multica_user }}.service
ConditionPathExists={{ server_config_multica_home }}/.multica/config.json

[Service]
Type=simple
User={{ server_config_multica_user }}
Group={{ server_config_multica_user }}
WorkingDirectory={{ server_config_multica_home }}
Environment=HOME={{ server_config_multica_home }}
Environment=PATH={{ server_config_android_sdk_root }}/platform-tools:{{ server_config_android_sdk_root }}/emulator:{{ server_config_android_sdk_root }}/cmdline-tools/latest/bin:{{ server_config_multica_home }}/.local/share/mise/shims:{{ server_config_multica_home }}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PI_CODING_AGENT_DIR={{ server_config_multica_pi_dir }}
Environment=MULTICA_PI_PATH={{ server_config_multica_home }}/.local/bin/pi
Environment=MULTICA_WORKSPACES_ROOT={{ server_config_multica_agent_workspaces }}
Environment=MULTICA_DAEMON_DEVICE_NAME={{ ansible_hostname }}-multica
Environment="MULTICA_AGENT_RUNTIME_NAME=Pi isolated"
Environment=MULTICA_DAEMON_MAX_CONCURRENT_TASKS={{ server_config_multica_daemon_max_tasks }}
Environment=MULTICA_DAEMON_AUTO_UPDATE=false
Environment=MULTICA_DAEMON_AUTO_RELOAD=false
Environment=MULTICA_AGENT_TIMEOUT=4h
Environment=DOCKER_HOST=unix://{{ server_config_docker_runtime_dir }}/{{ server_config_multica_user }}/docker.sock
Environment=ANDROID_HOME=/opt/android-sdk
Environment=ANDROID_SDK_ROOT=/opt/android-sdk
ExecStart=/usr/local/bin/multica daemon start --foreground --no-auto-update --no-auto-reload
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=120
KillMode=mixed
UMask=0077
LimitNOFILE=65536
MemoryHigh=24G
MemoryMax=28G
TasksMax=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths={{ server_config_multica_home }} {{ ansible_user_dir }}/dev
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
